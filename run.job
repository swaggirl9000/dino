#!/bin/bash
#SBATCH --job-name=dino
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00         
#SBATCH --output=logs/prepocess_%j.txt

module purge
module load 2023
module load CUDA/12.4.0

cd $HOME/IPT-Equivariant-VAE/dino/InvariantRepresentation
source activate dino

srun python qm9_train.py
