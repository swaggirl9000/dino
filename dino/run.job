#!/bin/bash
#SBATCH --partition=gpu_a100   # Forces it to use the A100 GPU partition
#SBATCH --gres=gpu:1           # Requests 1 GPU (crucial for PyTorch)
#SBATCH --time=24:00:00        # Make sure you ask for enough time
#SBATCH --array=1-4          # Spawns 5 separate jobs (0 through 4)

module purge
module load 2023
 module load CUDA/12.4.0

PROJECT=$HOME/IPT-Equivariant-VAE/dino/InvariantRepresentation
cd "$PROJECT"
source activate ect_qm9

TARGET_VAR=${TARGET:-alpha}

# Define the models and conditions mapping
MODELS=("baseline" "ect"    "ect"        "ect"        "ect")
CONDS=( "concat"   "concat" "film-final" "film-layer" "adaln-layer")

# Get the specific model for this task ID
CURRENT_MODEL=${MODELS[$SLURM_ARRAY_TASK_ID]}
CURRENT_COND=${CONDS[$SLURM_ARRAY_TASK_ID]}

echo "Running task $SLURM_ARRAY_TASK_ID: Target=$TARGET_VAR, Model=$CURRENT_MODEL, Cond=$CURRENT_COND"

python train_egnn.py --target $TARGET_VAR --model $CURRENT_MODEL --cond-type $CURRENT_COND
